generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(uuid())
  clerkUserId String     @unique
  email       String     @unique
  firstName   String?
  lastName    String?
  fullName    String?
  imageUrl    String?
  properties    Property[]
  tenants       Tenant[]
  agreements    RentalAgreement[]
  utilityTypes  UtilityType[]
  utilityConfigs PropertyUtilityConfig[]
  meters        Meter[]
  meterReadings MeterReading[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Property {
  id           String       @id @default(uuid())
  userId       String
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  country      String
  postalCode   String?
  area         Decimal?     @db.Decimal(10, 2)
  rooms        Int?
  propertyType PropertyType @default(APARTMENT)
  notes        String?
  isArchived   Boolean      @default(false)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreements   RentalAgreement[]
  utilityConfigs PropertyUtilityConfig[]
  meters         Meter[]
  meterReadings  MeterReading[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([userId, isArchived])
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  OTHER
}

model Tenant {
  id              String        @id @default(uuid())
  userId          String
  fullName        String
  phone           String?
  email           String?
  messengerType   MessengerType @default(OTHER)
  messengerHandle String?
  notes           String?
  isArchived      Boolean       @default(false)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreements      RentalAgreement[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([userId, isArchived])
}

enum MessengerType {
  TELEGRAM
  WHATSAPP
  VIBER
  EMAIL
  PHONE
  OTHER
}

model RentalAgreement {
  id                  String          @id @default(uuid())
  userId              String
  propertyId          String
  tenantId            String
  startDate           DateTime        @db.Date
  endDate             DateTime?       @db.Date
  status              AgreementStatus @default(ACTIVE)
  monthlyRentAmount   Decimal         @db.Decimal(12, 2)
  monthlyRentCurrency Currency        @default(UAH)
  paymentDueDay       Int
  depositAmount       Decimal?        @db.Decimal(12, 2)
  depositCurrency     Currency        @default(UAH)
  notes               String?
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  property            Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([propertyId, status])
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum Currency {
  UAH
  USD
  EUR
}

model UtilityType {
  id          String                  @id @default(uuid())
  userId      String?
  name        String
  description String?
  isSystem    Boolean                 @default(false)
  user        User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  configs     PropertyUtilityConfig[]
  meters      Meter[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model PropertyUtilityConfig {
  id            String      @id @default(uuid())
  userId        String
  propertyId    String
  utilityTypeId String
  isEnabled     Boolean     @default(true)
  defaultAmount Decimal?    @db.Decimal(12, 2)
  notes         String?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  utilityType   UtilityType @relation(fields: [utilityTypeId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([propertyId, utilityTypeId])
  @@index([userId])
  @@index([propertyId])
  @@index([utilityTypeId])
}

model Meter {
  id                 String           @id @default(uuid())
  userId             String
  propertyId         String
  utilityTypeId      String
  name               String
  providerName       String?
  accountNumber      String?
  submissionMethod   SubmissionMethod @default(OTHER)
  submissionUrl      String?
  submissionEmail    String?
  submissionDayStart Int?
  submissionDayEnd   Int?
  notes              String?
  isActive           Boolean          @default(true)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  property           Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  utilityType        UtilityType      @relation(fields: [utilityTypeId], references: [id], onDelete: Restrict)
  readings           MeterReading[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([utilityTypeId])
  @@index([propertyId, isActive])
}

model MeterReading {
  id                           String             @id @default(uuid())
  userId                       String
  meterId                      String
  propertyId                   String
  periodMonth                  Int
  periodYear                   Int
  previousValue                Decimal?           @db.Decimal(12, 3)
  currentValue                 Decimal?           @db.Decimal(12, 3)
  consumption                  Decimal?           @db.Decimal(12, 3)
  readingReceivedFromTenantAt  DateTime?
  submittedToProviderAt        DateTime?
  status                       MeterReadingStatus @default(WAITING_FOR_TENANT)
  notes                        String?
  user                         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  meter                        Meter              @relation(fields: [meterId], references: [id], onDelete: Cascade)
  property                     Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  @@unique([meterId, periodMonth, periodYear])
  @@index([userId])
  @@index([propertyId])
  @@index([meterId])
  @@index([periodYear, periodMonth])
}

enum SubmissionMethod {
  WEBSITE
  EMAIL
  PHONE
  MESSENGER
  IN_PERSON
  OTHER
}

enum MeterReadingStatus {
  WAITING_FOR_TENANT
  RECEIVED_FROM_TENANT
  SUBMITTED_TO_PROVIDER
  NOT_REQUIRED
}
