generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(uuid())
  clerkUserId String     @unique
  email       String     @unique
  firstName   String?
  lastName    String?
  fullName    String?
  imageUrl    String?
  properties  Property[]
  tenants     Tenant[]
  agreements  RentalAgreement[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Property {
  id           String       @id @default(uuid())
  userId       String
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  country      String
  postalCode   String?
  area         Decimal?     @db.Decimal(10, 2)
  rooms        Int?
  propertyType PropertyType @default(APARTMENT)
  notes        String?
  isArchived   Boolean      @default(false)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreements   RentalAgreement[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
  @@index([userId, isArchived])
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  OTHER
}

model Tenant {
  id              String        @id @default(uuid())
  userId          String
  fullName        String
  phone           String?
  email           String?
  messengerType   MessengerType @default(OTHER)
  messengerHandle String?
  notes           String?
  isArchived      Boolean       @default(false)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreements      RentalAgreement[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([userId, isArchived])
}

enum MessengerType {
  TELEGRAM
  WHATSAPP
  VIBER
  EMAIL
  PHONE
  OTHER
}

model RentalAgreement {
  id                  String          @id @default(uuid())
  userId              String
  propertyId          String
  tenantId            String
  startDate           DateTime        @db.Date
  endDate             DateTime?       @db.Date
  status              AgreementStatus @default(ACTIVE)
  monthlyRentAmount   Decimal         @db.Decimal(12, 2)
  monthlyRentCurrency Currency        @default(UAH)
  paymentDueDay       Int
  depositAmount       Decimal?        @db.Decimal(12, 2)
  depositCurrency     Currency        @default(UAH)
  notes               String?
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  property            Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([propertyId, status])
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum Currency {
  UAH
  USD
  EUR
}
